# HTTP Server Configuration
HOST=0.0.0.0
PORT=8080

# PKCS#11 Library path
PKCS11_LIB_PATH=C:\Program Files\SoftHSM2\lib\softhsm2-x64.dll

# HSM Token Selection (specify label or slot index)
HSM_TOKEN_LABEL=arkion-token
HSM_SLOT_INDEX=0

# HSM User PIN
HSM_USER_PIN=1234

# Session Pool Configuration
HSM_SESSION_POOL_SIZE=4
HSM_ACQUISITION_TIMEOUT_MS=5000
HSM_OPERATION_TIMEOUT_MS=10000

# HSM Key Identities
HSM_ECDSA_KEY_LABEL=arkion-intermediate-prod
HSM_AES_KEY_LABEL=arkion-aes-key
